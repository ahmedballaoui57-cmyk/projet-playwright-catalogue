    {
      "name": "Catégories",
      "item": [
        {
          "name": "Liste des catégories",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Statut 200\", () => pm.response.to.have.status(200));",
                  "const categories = pm.response.json();",
                  "pm.test(\"Chaque catégorie a un nom et un nombre de livres\", () => {",
                  "    pm.expect(categories).to.be.an(\"array\").that.is.not.empty;",
                  "    categories.forEach(c => {",
                  "        pm.expect(c).to.have.all.keys(\"id\", \"nom\", \"nb_livres\");",
                  "        pm.expect(c.nom).to.be.a(\"string\").that.is.not.empty;",
                  "        pm.expect(c.nb_livres).to.be.at.least(0);",
                  "    });",
                  "});",
                  "pm.test(\"Les noms sont uniques\", () => {",
                  "    const noms = categories.map(c => c.nom);",
                  "    pm.expect(new Set(noms).size).to.eql(noms.length);",
                  "});",
                  "pm.test(\"La somme des livres par catégorie égale le total des livres\", () => {",
                  "    const somme = categories.reduce((s, c) => s + c.nb_livres, 0);",
                  "    pm.expect(somme).to.eql(Number(pm.collectionVariables.get(\"total_livres\")));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/categories",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "categories"
              ]
            }
          }
        },
        {
          "name": "Indicateurs par catégorie",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Statut 200\", () => pm.response.to.have.status(200));",
                  "const indicateurs = pm.response.json();",
                  "pm.test(\"Chaque ligne a tous ses indicateurs\", () => {",
                  "    pm.expect(indicateurs).to.be.an(\"array\").that.is.not.empty;",
                  "    indicateurs.forEach(i => pm.expect(i).to.have.all.keys(",
                  "        \"categorie\", \"nb_livres\", \"prix_moyen\", \"prix_min\", \"prix_max\", \"note_moyenne\"));",
                  "});",
                  "pm.test(\"Le prix moyen est entre le minimum et le maximum\", () => {",
                  "    indicateurs.forEach(i => pm.expect(i.prix_moyen).to.be.within(i.prix_min, i.prix_max));",
                  "});",
                  "pm.test(\"La note moyenne est entre 1 et 5\", () => {",
                  "    indicateurs.forEach(i => pm.expect(i.note_moyenne).to.be.within(1, 5));",
                  "});",
                  "pm.test(\"Les catégories les plus fournies sont en premier\", () => {",
                  "    const nombres = indicateurs.map(i => i.nb_livres);",
                  "    pm.expect(nombres).to.eql([...nombres].sort((a, b) => b - a));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/categories/indicateurs",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "categories",
                "indicateurs"
              ]
            }
          }
